# =====================================================================
# 2. Large Datasets & Static Storage
# =====================================================================
/data/
/data_static/*

# Un-ignore ONLY raw and preprocessed data folders
!/data_static/raw/
!/data_static/preprocessed/

# Ignore old data and feature caches inside preprocessed/
/data_static/preprocessed/old_data/
/data_static/preprocessed/betterdata/
/data_static/preprocessed/stat_cache/
/data_static/preprocessed/deberta_cache/
/data_static/preprocessed/recipe_cache/

# Binary data formats
